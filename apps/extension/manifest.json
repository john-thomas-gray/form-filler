{
  "manifest_version": 3,
  "name": "Form Filler (Dev)",
  "version": "0.0.0",
  "description": "Fills common form fields based on keyword rules.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
