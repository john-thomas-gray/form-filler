{
  "manifest_version": 3,
  "name": "Form Filler (Dev)",
  "version": "0.0.0",
  "description": "Fills common form fields based on keyword rules.",
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["documents/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
